{
  "comment-critic": {
    "SessionStart": [
      { "type": "command", "command": "python3 hooks/comment-critic.py --policy", "timeout": 5 }
    ],
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|run_command",
        "hooks": [{ "type": "command", "command": "python3 hooks/comment-critic.py", "timeout": 5 }]
      }
    ],
    "PreInvocation": [
      { "type": "command", "command": "python3 hooks/comment-critic.py --inject", "timeout": 5 }
    ]
  }
}
